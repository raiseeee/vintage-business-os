# Copia questo file in .env.local e compila i valori. NON committare .env.local.
# Si trovano in Supabase: Project Settings → API (URL) e API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=
# Chiave pubblica "publishable" (oppure la "anon key" legacy): è pensata per stare nel browser,
# la protezione dei dati è affidata alle policy RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NON inserire qui la service_role / secret key: in questa fase non serve.
# Quando serviranno integrazioni esterne, le relative chiavi
# vanno solo in variabili d'ambiente server-side, mai con prefisso NEXT_PUBLIC_.

# Solo per creare account dalla pagina Collaboratori. Chiave SEGRETA: va solo nelle variabili
# d'ambiente del server (Vercel → Environment Variables), mai nel repository né con prefisso NEXT_PUBLIC_.
# Senza questa chiave l'app funziona, ma la creazione diretta degli account è disattivata.
SUPABASE_SERVICE_ROLE_KEY=
